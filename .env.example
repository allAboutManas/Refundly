# --- Supabase (client) -----------------------------------------------------
# These two values are SAFE to expose in the frontend bundle.
# The anon key is a public key protected by Row Level Security.
# NEVER put the service_role key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- App -------------------------------------------------------------------
VITE_APP_NAME=Refundly
# Default timezone for new profiles (India). IANA name.
VITE_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Android app download (optional) ---------------------------------------
# Where the Android APK is hosted. Leave unset to serve public/refundly.apk,
# or point it at an external URL (GitHub Releases, Supabase Storage, a CDN…).
VITE_ANDROID_APK_URL=
# Optional version label shown next to the download button, e.g. 1.0.0
VITE_ANDROID_APP_VERSION=

# --- Web push (optional) ---------------------------------------------------
# VAPID *public* key (safe for the browser). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Put the private key in Supabase Edge Function secrets (VAPID_PRIVATE), not here.
VITE_VAPID_PUBLIC_KEY=
